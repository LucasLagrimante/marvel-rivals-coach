# Cloudflare Pages — cabeçalhos de cache.
# JS/CSS/fontes do Vite têm hash no nome: imutáveis por 1 ano.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Arte dos heróis, team-ups e ranking: estável entre deploys, revalida em segundo plano.
/heroes/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/teamups/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/rankings/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# O service worker precisa ser sempre revalidado para novas versões entrarem.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
